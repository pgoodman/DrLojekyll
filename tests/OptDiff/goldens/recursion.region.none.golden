region-program
program-root {
  input-abi   input/1(A:i32)      -> R0 via P0
  query-abi   output(A:free i32)  -> permanent-root
  output-abi  <none>
}
region R0  owner=program-root  parents=()  children=() {
  input-port      P0  message=input/1  fields=(A)
  permanent-root  output(A)
  row-contract    E0  rel=output            member-key=(A)  support=monotone
  row-contract    E1  rel=one               member-key=(A)  support=monotone
  row-contract    E2  rel=direct_const      member-key=(A)  support=monotone
  row-contract    E3  rel=direct_input      member-key=(A)  support=monotone
  row-contract    E4  rel=direct_only       member-key=(A)  support=monotone
  row-contract    E5  rel=direct_only_join  member-key=(A)  support=monotone
  row-contract    E6  rel=direct_and_join   member-key=(A)  support=monotone
  recursive-component  C0  members=(direct_const)
  recursive-component  C1  members=(direct_input)
  recursive-component  C2  members=(direct_only)
  recursive-component  C3  members=(direct_only_join)
  recursive-component  C4  members=(direct_and_join)
  rule  R0  produces=output  routes=(direct_const.A->output.A)
  rule  R1  produces=output  routes=(direct_input.A->output.A)
  rule  R2  produces=output  routes=(direct_only.A->output.A)
  rule  R3  produces=output  routes=(direct_only_join.A->output.A)
  rule  R4  produces=output  routes=(direct_and_join.A->output.A)
  rule  R6  produces=direct_const  routes=(direct_const.A->direct_const.A)
  rule  R7  produces=direct_const  routes=(one.A->direct_const.A)
  rule  R8  produces=direct_input  routes=(direct_input.A->direct_input.A)
  rule  R10  produces=direct_only  routes=(direct_only.A->direct_only.A)
  rule  R11  produces=direct_only_join  routes=(direct_only_join.A->direct_only_join.A)
  rule  R12  produces=direct_and_join  routes=(direct_and_join.A->direct_and_join.A)
  rule  R13  produces=direct_and_join  routes=(direct_and_join.A->direct_and_join.A)
  fused-fixpoint  C0  binding-prefix=(A)
  fused-fixpoint  C1  binding-prefix=(A)
  fused-fixpoint  C2  binding-prefix=(A)
  fused-fixpoint  C3  binding-prefix=(A)
  fused-fixpoint  C4  binding-prefix=(A)
}
