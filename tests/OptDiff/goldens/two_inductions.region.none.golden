region-program
program-root {
  input-abi   input/1(A:i32)         -> R0 via P0
  input-abi   blah1/2(A:i32, B:i32)  -> R0 via P1
  input-abi   blah2/2(A:i32, B:i32)  -> R0 via P2
  query-abi   output(A:bound i32)    -> request-port P3
  output-abi  <none>
}
region R0  owner=program-root  parents=()  children=() {
  input-port    P0  message=input/1  fields=(A)
  input-port    P1  message=blah1/2  fields=(A, B)
  input-port    P2  message=blah2/2  fields=(A, B)
  request-port  P3  query=output/1  bound=(A)  plan=full-key-hash-lookup
  row-contract  E0  rel=output  member-key=(A)  support=monotone
  row-contract  E1  rel=loop1   member-key=(A)  support=monotone
  row-contract  E2  rel=loop2   member-key=(A)  support=monotone
  recursive-component  C0  members=(loop1)
  recursive-component  C1  members=(loop2)
  rule  R0  produces=output  routes=(loop2.A->output.A)
  rule  R3  produces=loop2  routes=(loop1.A->loop2.A)
  shared-field  F0  members=(output.A, loop2.A)
  joint-fixpoint  C0
  joint-fixpoint  C1
}
census: regions=1 child-calls=0 program-roots=1 request-ports=1 input-ports=3 result-ports=0 row-contracts=3
