dataflow

select ^select.0 (A:i32, B:i32)                    ; recv #message feed/2
  ATTRIBUTES eqset=1 class=table-less stratum=0 tag=build/predicate-select
  => ^tuple.4 (A, B)

select ^select.1 (A:i32)                           ; recv #message unsee/1
  ATTRIBUTES eqset=2 class=table-less stratum=1 tag=build/predicate-select
  => ^tuple.2 (A)

tuple ^tuple.2 (A:i32)
  ATTRIBUTES table=%table:8 eqset=2 class=monotone stratum=2 tag=build/negate-matched

tuple ^tuple.3 (A:i32, B:i32)
  ATTRIBUTES table=%table:4 eqset=4 class=differential stratum=5 tag=link/insert-proxy
  => ^insert.6 (A, B)

tuple ^tuple.4 (A:i32, B:i32)
  ATTRIBUTES table=%table:11 eqset=1 class=monotone stratum=3 tag=link/negate-source-proxy
  => ^negate.5 (B, A)

negate ^negate.5 (A:i32, B:i32)                    ; negates ^tuple.2
  ATTRIBUTES table=%table:4 eqset=4 class=differential stratum=4 tag=build/negate-predicate
  => ^tuple.3 (A, B)

insert ^insert.6 (A:i32, B:i32) into %table:4
  ATTRIBUTES eqset=4 class=differential stratum=6 tag=connect/query-insert
