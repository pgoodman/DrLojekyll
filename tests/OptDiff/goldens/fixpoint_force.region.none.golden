region-program
program-root {
  input-abi   src_c/2(K:u64, V:u64)  -> R0 via P0
  output-abi  out_p/2(K:u64, V:u64)  -> R0 via P1
}
region R0  owner=program-root  parents=()  children=() {
  input-port    P0  message=src_c/2  fields=(K, V)
  result-port   P1  message=out_p/2  fields=(K, V)
  row-contract  E0  rel=c  member-key=(K, V)  support=monotone
  row-contract  E1  rel=p  member-key=(K, V)  support=monotone
  row-contract  E2  rel=a  member-key=(K, V)  support=monotone
  row-contract  E3  rel=b  member-key=(K, V)  support=monotone
  rule  R1  produces=p  routes=(a.K->p.K, a.V->p.V)
  rule  R2  produces=p  routes=(b.K->p.K, b.V->p.V)
  rule  R3  produces=a  routes=(c.K->a.K, c.V->a.V)
  rule  R4  produces=b  routes=(c.K->b.K, c.V->b.V)
  shared-field  F0  members=(c.K, p.K, a.K, b.K)
  shared-field  F1  members=(c.V, p.V, a.V, b.V)
}
