region-program
program-root {
  input-abi   input/1(A:i32)      -> R0 via P0
  query-abi   output(A:free i32)  -> permanent-root
  output-abi  <none>
}
region R0  owner=program-root  parents=()  children=() {
  input-port      P0  message=input/1  fields=(A)
  permanent-root  output(A)
  row-contract    E0  rel=output  member-key=(A)  support=monotone
}
census: regions=1 child-calls=0 program-roots=1 request-ports=0 input-ports=1 result-ports=0 row-contracts=1
