region-program
program-root {
  input-abi   log_in/1(UserId:i32)                 -> R0 via P0
  input-abi   add_user/1(UserID:i32)               -> R0 via P1
  query-abi   user_is_logged_in(UserId:bound i32)  -> request-port P2
  output-abi  <none>
}
region R0  owner=program-root  parents=()  children=() {
  input-port    P0  message=log_in/1    fields=(UserId)
  input-port    P1  message=add_user/1  fields=(UserID)
  request-port  P2  query=user_is_logged_in/1  bound=(UserId)  plan=full-key-hash-lookup
  row-contract  E0  rel=                   member-key=()        support=monotone
  row-contract  E1  rel=user_is_logged_in  member-key=(UserId)  support=monotone
  row-contract  E2  rel=user               member-key=(UserID)  support=monotone
  rule  R1  produces=user_is_logged_in  routes=(user.UserID->user_is_logged_in.UserId)
  shared-field  F0  members=(user_is_logged_in.UserId, user.UserID)
}
census: regions=1 child-calls=0 program-roots=1 request-ports=1 input-ports=2 result-ports=0 row-contracts=3
