# demand_kv_body_1 oracle sidecar: KV value-churn via accumulation.
# `credit` is monotone (add-only); several credits fold into one per-account
# balance through the @invertible add_u32 sum.
# Batch 1: two credits into account 100, one into 200.
# Batch 2: another credit into 200 (churn), a fresh account 300.
batch
+ credit 100 10
+ credit 100 25
+ credit 200 7
end
batch
+ credit 200 3
+ credit 300 50
end
