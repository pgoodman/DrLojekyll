# demand_mutual_content_1 oracle sidecar: pins the mutual-recursion fixpoint
# (ra <- rb <- ra through `step`). base/step are monotone messages (adds only).
# The oracle runs the PLAIN (undemanded) program -- the answer-identity referee
# for the demand-ON reject this case witnesses.
#
# Batch 1: key 100 seeded at value 1 over the chain 1->2->3->4->5.
#   ra(100,.) = even-step reachable from 1 = {1,3,5}
#   rb(100,.) = odd-step  reachable from 1 = {2,4}
batch
+ base 100 1
+ step 1 2
+ step 2 3
+ step 3 4
+ step 4 5
end
# Batch 2: a second key 200 seeded at value 2 over the SAME chain.
#   ra(200,.) = even-step reachable from 2 = {2,4}
#   rb(200,.) = odd-step  reachable from 2 = {3,5}
batch
+ base 200 2
end
