; key_unknown_1 -- @demand RESOLVE obligation (all-4-modes reject,
; flag-INDEPENDENT -- no .drflags: the malformed pragma rejects at parse
; before any transform runs): every instance key column must name a declared parameter; `@key(Missing)`
; draws the unknown-key-column diagnostic (resolved IMMEDIATELY -- params are bound at the pragma site).
#message edge_2(u64 From, u64 To).
#local path(u64 From, u64 To) @key(Missing).
path(F, T) : edge_2(F, T).
#query reachable_from(bound u64 From, free u64 To) : path(From, To).
